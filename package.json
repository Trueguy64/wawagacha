{
  "name": "wawagacha",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter server build && pnpm --filter web build",
    "start": "pnpm --filter server start",
    "db:push": "pnpm --filter server db:push",
    "db:studio": "pnpm --filter server db:studio",
    "typecheck": "pnpm --filter server typecheck && pnpm --filter web typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
