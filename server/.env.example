# Copy to .env and fill in.

DATABASE_URL="file:./dev.db"

# Password for the admin website. Anything you like — it is the only credential.
ADMIN_PASSWORD="change-me"

# Used to sign the session cookie. Any long random string.
COOKIE_SECRET="change-me-to-something-long-and-random"

# Optional: enables drag-and-drop image uploads to Imgur in the admin UI.
# Create an application at https://api.imgur.com/oauth2/addclient (choose
# "anonymous usage without user authorization") and paste the Client ID here.
# Without it you can still paste image URLs directly.
IMGUR_CLIENT_ID=""

PORT=3000

# --- Discord bot -----------------------------------------------------------
# From https://discord.com/developers/applications → your app:
#   DISCORD_TOKEN     → Bot → Reset Token
#   DISCORD_CLIENT_ID → General Information → Application ID
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""

# Optional: your test server's ID. Set it while developing so slash-command
# changes appear instantly instead of taking up to an hour to propagate.
DISCORD_GUILD_ID=""
