{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "bot": "node dist/bot/index.js",
    "bot:dev": "tsx watch src/bot/index.ts",
    "bot:deploy": "tsx src/bot/deploy-commands.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "node-cron": "^4.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.1",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
